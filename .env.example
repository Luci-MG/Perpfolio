# Binance read-only API credentials
# Generate at: Binance → Profile → API Management → Create API
# Enable: Read Only. Disable: trading, withdrawals.
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Hyperliquid — just your public wallet address (no secret needed for reads)
HL_WALLET_ADDRESS=0xYourWalletAddressHere

# Server port (optional, defaults to 3000)
PORT=3000
